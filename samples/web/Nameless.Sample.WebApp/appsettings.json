{
  "AllowedHosts": "*",

  "HealthCheck": {
    "LivenessPath": "health",
    "ReadinessPath": "ready",
    "ReadinessTags": []
  },

  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "OAuthClient": {
    "TokenEndpoint": "https://localhost:8443/token/connect",
    "ClientId": "sample_web_api",
    "ClientSecret": "secret",
    "ClientAuthentication": "ClientSecretBasic",
    "ClockSkew": "00:00:15"
  },

  "OAuthClientCredentials": {
    "Scope": "sample_web_api:write",
    "Audience": "sample_web_api"
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Information"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ],
    "Properties": {
      "ApplicationName": "Web Sample"
    }
  }
}
