{
  "ConnectionStrings": {
    "Default": "Data Source=databases/sqlite.db;Pooling=false;"
  },

  "Bootstrapper": {
    "Timeout": -1
  },

  "EntityFrameworkCore": {
    "ConnectionStringName": "Default"
  },

  "GitHub": {
    "Owner": "marcoaoteixeira",
    "Repository": "InfoPhoenix"
  },

  "Lucene": {
    "DirectoryName": "databases"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },

  "ResourceLocalizer": {
    "ResourceFullName": "Nameless.WinApp.Resources.Translations"
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "rollingOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ],
    "Properties": {
      "ApplicationName": "WinApp"
    }
  }
}
