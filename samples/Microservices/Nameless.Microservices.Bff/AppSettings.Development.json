{
  // *** .NET ***
  "ConnectionStrings": {
    "postgresdb": "Server=localhost;Port=5432;Database=microservices;User Id=user;Password=password"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // *** PRO Common Library ***
  "Bootstrap": {
    "RunInParallel": false,
    "MaxDegreeOfParallelism": 4
  },

  "CorsPolicies": {
    "AllowEverything": {
      "Headers": "*",
      "Methods": "*",
      "Origins": "*",
      "SupportsCredentials": false,
      "Skip": false
    },
    "OnlyGet": {
      "Headers": "*",
      "Methods": "GET",
      "Origins": "*",
      "SupportsCredentials": false,
      "Skip": false
    }
  },

  "DataProtection": {
    "UseFileSystem": false,
    "FileSystemPath": null,
    "ApplicationDiscriminator": null
  },

  "EntityFrameworkCore": {
    "ConnectionStringName": "postgresdb",
    "UseInMemory": false
  },

  "HttpRequestCorrelation": {
    "HeaderKey": "X-Correlation-ID",
    "IncludeInResponse": true
  },

  "JsonWebTokens": {
    "IdentityServer": {
      "Authority": "https://identity.dev.enhesa.com",
      "Issuers": [],
      "ValidateIssuer": false,
      "Audiences": [],
      "ValidateAudience": false,
      "ValidateLifetime": false,
      "ClockSkew": 30,
      "HashAlgorithm": "HmacSha256",
      "ValidateIssuerSigninKey": false,
      "Secret": null
    }
  },

  "OAuth": {
    "AuthorityUrl": "https://identity.dev.enhesa.com",
    "TokenEndpoint": "/connect/token"
  },

  "OutputCachePolicies": {
    "FiveSeconds": {
      "ExpiresIn": "00:00:05",
      "Skip": false
    },
    "FifteenSeconds": {
      "ExpiresIn": "00:00:15",
      "Skip": false
    }
  },

  "RequestTimeoutPolicies": {
    "OneSecond": {
      "ExpiresIn": "00:00:01",
      "Skip": false
    },
    "ThreeSeconds": {
      "ExpiresIn": "00:00:03",
      "Skip": false
    }
  },

  "Scalar": {
    "AuthorizationSchemes": {
      "Bearer": {
        "ClientId": "chemical_watch_client",
        "ClientSecret": "secret",
        "GrantType": "client_credentials"
      }
    }
  }
}
