<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<RootNamespace>Nameless.Microservices.Api</RootNamespace>
		<EmitCompilerGeneratedFiles>True</EmitCompilerGeneratedFiles>
		<UseAutoEndpoints>True</UseAutoEndpoints>
		<InterceptorsNamespaces>
			$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated
		</InterceptorsNamespaces>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\src\Nameless.Web\Nameless.Web.csproj" />
		<ProjectReference Include="..\Nameless.Microservices.Contracts\Nameless.Microservices.Contracts.csproj" />
		<!-- Local-dev only: wire the generator when UseAutoEndpoints=True. -->
		<!-- NuGet consumers get this via Nameless.Web.targets (auto-imported from build/ folder). -->
		<!-- ProjectReference targets are NOT auto-imported, so we must do this explicitly here. -->
		<ProjectReference Include="..\..\..\generators\Nameless.Web.Http.Endpoints.Generator\Nameless.Web.Http.Endpoints.Generator.csproj"
		                  OutputItemType="Analyzer"
		                  ReferenceOutputAssembly="false"
		                  Condition="'$(UseAutoEndpoints)' == 'True'" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="generated/**/*.cs" />
	</ItemGroup>

</Project>
