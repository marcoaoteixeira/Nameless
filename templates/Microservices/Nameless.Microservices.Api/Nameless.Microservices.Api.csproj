<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<RootNamespace>Nameless.Microservices.Api</RootNamespace>
		<EmitCompilerGeneratedFiles>True</EmitCompilerGeneratedFiles>
		<UseAutoEndpoints>True</UseAutoEndpoints>
		<InterceptorsNamespaces>
			$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated
		</InterceptorsNamespaces>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\src\Nameless.Web\Nameless.Web.csproj" />
		<ProjectReference Include="..\Nameless.Microservices.Contracts\Nameless.Microservices.Contracts.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="generated/**/*.cs" />
	</ItemGroup>

</Project>
