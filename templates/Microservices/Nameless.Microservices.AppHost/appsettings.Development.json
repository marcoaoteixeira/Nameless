{
  "Resources": {
    "postgres": {
      "Image": "postgres:17.10-alpine",
      "HostPort": 5432,
      "VolumeName": "microservices-postgres-data",
      "IsPersistent": true,
      "Environment": {
        "POSTGRES_DB": "microservices",
        "POSTGRES_USER": "postgres",
        "POSTGRES_PASSWORD": "postgres"
      },
      "PgAdmin": {
        "Image": "elestio/pgadmin:REL-9_15",
        "HostPort": 6432,
        "IsPersistent": true,
        "Environment": {
          "PGADMIN_DEFAULT_EMAIL": "pgadmin@pgadmin.com",
          "PGADMIN_DEFAULT_PASSWORD": "pgadmin"
        }
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
